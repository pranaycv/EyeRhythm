---
import Legal from "../components/Legal.astro";
import { site } from "../config";
---

<Legal
  kicker="Terms"
  title="Terms, EyesRhythm"
  description="EyesRhythm is free to download for noncommercial use on macOS and Windows."
  heading="Free to download."
  lede="Simple terms for the Mac and Windows app."
>
  <p>
    EyesRhythm is free to download for macOS and Windows. There is no
    subscription and no license key.
  </p>
  <p>
    You may use it for a noncommercial purpose. The software is under the{" "}
    <a href="https://polyformproject.org/licenses/noncommercial/1.0.0">
      PolyForm Noncommercial License 1.0.0</a>. Commercial use is not included.
    The license text and the required notice are on the{" "}
    <a href="/notices">notices</a> page.
  </p>
  <p>
    EyesRhythm watches blink rhythm through your camera, on this computer. It
    is a wellness companion. It is not a medical device, and it is not meant
    to diagnose, treat, or prevent disease.
  </p>
  <p>
    You need a working webcam and a current macOS or Windows version. Camera
    permission is yours to give. Without it, the companion cannot count blinks.
    {site.recommendedMachine}
  </p>
  <p>
    There is nothing to pay on this site, so there is nothing to refund.
  </p>
  <p>
    Questions:{" "}
    <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
  </p>
</Legal>
